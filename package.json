{
    "name": "n8n-nodes-newlead",
    "version": "2.0.0",
    "description": "N8N community node for Newlead Platform - send templates, manage leads and properties, start voice calls, control AI responses",
    "license": "MIT",
    "homepage": "https://newlead.ai",
    "keywords": [
        "n8n-community-node-package",
        "n8n",
        "whatsapp",
        "crm",
        "newlead",
        "templates",
        "messaging",
        "automation"
    ],
    "author": {
        "name": "Sebastián Almirón",
        "email": "sebastn.almiron@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/sebastnalmiron/n8n-newlead.git"
    },
    "scripts": {
        "build": "n8n-node build",
        "build:watch": "tsc --watch",
        "dev": "n8n-node dev",
        "lint": "n8n-node lint",
        "test": "vitest run --maxWorkers=1",
        "lint:fix": "n8n-node lint --fix",
        "release": "n8n-node release",
        "prepublishOnly": "n8n-node prerelease"
    },
    "files": [
        "dist"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "strict": true,
        "credentials": [
            "dist/credentials/NewleadApi.credentials.js"
        ],
        "nodes": [
            "dist/nodes/Newlead/Newlead.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "^0.48.4",
        "eslint": "9.32.0",
        "prettier": "3.6.2",
        "release-it": "^19.0.4",
        "typescript": "5.9.2",
        "vitest": "^4.1.12"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    }
}
